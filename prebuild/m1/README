Linux:
# Download M55
./dldtool /dev/ttyUSBx programmer.bin vela_ota.bin
./dldtool /dev/ttyUSBx programmer.bin -m 0x2C300000/0xBE57EC1C vela_ap.bin
# Download BTH
./dldtool /dev/ttyUSBx programmer.bin vela_cp.bin
# Download HFII4(dsp)
./dldtool /dev/ttyUSBx programmer.bin vela_audio.bin
# Download Sensor Hub
./dldtool /dev/ttyUSBx programmer.bin vela_sensor.bin
# Download All
./dldtool /dev/ttyUSBx programmer.bin vela_ota.bin -m 0x2C300000/0xBE57EC1C vela_ap.bin vela_cp.bin vela_audio.bin vela_sensor.bin

# M55 flash上用littlefs

#  分区表
    ota    0x2C000000 - 0x2C080000 512K
    sst    0x2C080000 - 0x2C100000 512K // secure storage used by tee
    tee    0x2C100000 - 0x2C300000 2M
    ap     0x2C300000 - 0x2CC00000 8M
    audio  0x2CC00000 - 0x2D000000 4M
    sensor 0x342BF000 - 0x343BF000 1M  // on flash1 with cp

#  data区的flash偏移, block size按照256算, data区偏移 36352*256 = 0x8E0000
#  flash基地址 0x2C000000, 得到data区烧写地址0x2C8E0000
#  目前sensor - 0x2CE00000, hifi4 - 0x2C400000, m55 - 0x2C000000, 都不冲突

D:\work\tools\dldtool.exe 9 D:\work\tools\programmer.bin --addr 0x2c8e0000 \\wsl$\Ubuntu-20.04\home\test01\xiaomi_m1\vendor\bes\prebuild\littlefs.bin

#  手动mount
mkdir /mnt/data
mount -t littlefs /dev/data /mnt/data
ls /mnt/data

