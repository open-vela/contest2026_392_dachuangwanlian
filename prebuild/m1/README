Xiaomi vela (M1,bes1600ep,1600)
# git拉代码
repo init -u ssh://p-wangyulong8@partner-gerrit.mioffice.cn:29418/velaos/manifest -b dev -m vela-bes-m1.xml --repo-url=https://mirrors.tuna.tsinghua.edu.cn/git/git-repo
repo sync -c
repo start dev --all
git checkout .

# 编译Sensor Hub (sensor hub如果打包在M55 BIN里,需要先编译sensor hub)
./build.sh vendor/bes/boards/best1600_ep/configs/sensor -j
# 编译M55
./build.sh vendor/bes/boards/best1600_ep/configs/ota -j
./build.sh vendor/bes/boards/best1600_ep/configs/ap -j
# 编译BTH
./build.sh vendor/bes/boards/best1600_ep/configs/cp -j
# 编译HIFI4(dsp)
#   HIFI4编译,工具链需要license,所以不能直接用xiaomi仓库里的prebuild下的clang,HIFI4编译环境参考 http://172.16.40.3/dokuwiki/doku.php?id=1600_m1_doc_sbc_aac_on_hifi4#%E5%AE%89%E8%A3%85hfi4%E7%8E%AF%E5%A2%83
#   工具链安装后,导出路径到PATH,build.sh后续到处prebuild的clang到PATH时候,会优先用我们自己导出的
./build.sh vendor/bes/boards/best_hifi4/configs/nsh -j

Windows:
# 下载M55
